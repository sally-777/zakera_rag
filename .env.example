# انسخ الملف ده باسم .env وعدّل اللي محتاجه. كله اختياري.

# --- الداتا ---
DATA_FILE=data/Egypt_Craft_Documentation.xlsx
# حالات السجلات اللي تدخل الفهرس. "*" = الكل (مناسب للديمو لأن كل السجلات حاليًا "مسودة")
# للنشر الفعلي: ALLOWED_STATUS=معتمد
ALLOWED_STATUS=*
# أرقام الأسئلة اللي ما تدخلش الفهرس (بيانات شخصية: س1 الاسم، س2 العمر، س40 وسيلة التواصل، س39 ملفات إضافية)
EXCLUDE_QUESTIONS=1,2,39,40
# لو 1: السيرفر يراقب ملف الإكسيل ويعيد الفهرسة تلقائيًا لما فريق الداتا يعدله
WATCH_DATA=1

# --- الـ Embeddings ---
# auto = يجرب fastembed ولو مش متاح يكمل بالبحث النصي (TF-IDF) بدون تحميل أي حاجة
EMBEDDER=auto
EMBED_MODEL=intfloat/multilingual-e5-large

# --- الـ LLM (كلهم ليهم نسخة مجانية؛ اختار واحد) ---
# auto = gemini لو في مفتاح، وإلا groq، وإلا ollama لو شغال، وإلا يرجّع المقاطع مباشرة (من غير LLM)
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# --- الـ API ---
ADMIN_TOKEN=
